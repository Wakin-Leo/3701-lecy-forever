onflict"]},{"doi":"10.1016/j.jesp.2015.11.003","t":"Fostering selflessness through I-sharing","a":["Mark Huneke","Elizabeth C. Pinel"],"d":"2015-11-18","abs":"","oa":"bronze","url":"https://doi.org/10.1016/j.jesp.2015.11.003","pdf":"","k":["Generosity","Similarity (geometry)","Social psychology","Psychology","Computer science","Theology","Philosophy","Artificial intelligence"]},{"doi":"10.1016/j.jesp.2015.11.001","t":"Understanding overconfidence: Theories of intelligence, preferential attention, and distorted self-assessment","a":["Joyce Ehrlinger","Ainsley Mitchum","Carol S. Dweck"],"d":"2015-11-06","abs":"Knowing what we don't yet know is critical for learning. Nonetheless, people typically overestimate their prowess—but is this true of everyone? Three studies examined who shows overconfidence and why. Study 1 demonstrated that participants with an entity (fixed) theory of intelligence, those known to avoid negative information, showed significantly more overconfidence than those with more incremental (malleable) theories. In Study 2, participants who were taught an entity theory of intelligence allocated less attention to difficult problems than those taught an incremental theory. Participants in this entity condition also displayed more overconfidence than those in the incremental condition, and this difference in overconfidence was mediated by the observed bias in attention to difficult problems. Finally, in Study 3, directing participants' attention to difficult aspects of the task reduced the overconfidence of those with more entity views of intelligence. Implications for reducing biased self-assessments that can interfere with learning were discussed.","oa":"hybrid","url":"https://www.sciencedirect.com/science/article/pii/S0022103115300135/pdf","pdf":"https://www.sciencedirect.com/science/article/pii/S0022103115300135/pdf","k":["Overconfidence effect","Psychology","Social psychology","Task (project management)","Cognitive psychology"]},{"doi":"10.1016/j.jesp.2015.10.010","t":"A lesson in bias: The relationship between implicit racial bias and performance in pedagogical contexts","a":["Drew S. Jacoby-Senghor","Stacey Sinclair","J. Nicole Shelton"],"d":"2015-11-04","abs":"","oa":"closed","url":"https://doi.org/10.1016/j.jesp.2015.10.010","pdf":"","k":["Psychology","Test (biology)","Racial bias","Social psychology","Race (biology)","White (mutation)","Implicit-association test","Quality (philosophy)"]},{"doi":"10.1016/j.jesp.2015.10.011","t":"My friends are all alike — the relation between liking and perceived similarity in person perception","a":["Hans Alves","Alex Koch","Christian Unkelbach"],"d":"2015-11-03","abs":"","oa":"closed","url":"https://doi.org/10.1016/j.jesp.2015.10.011","pdf":"","k":["Counterintuitive","Psychology","Social psychology","Similarity (geometry)","Perception","Social perception","Impression formation","Interpersonal attraction"]},{"doi":"10.1016/j.jesp.2015.10.007","t":"Suspicion of motives predicts minorities' responses to positive feedback in interracial interactions","a":["Brenda Major","Jonathan W. Kunstman","Brenna D. Malta","Pamela J. Sawyer","Sarah S. M. Townsend","Wendy Berry Mendes"],"d":"2015-11-03","abs":"","oa":"green","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/4682049","pdf":"","k":["Ethnic group","Psychology","Social psychology","Feeling","Ambiguity","White (mutation)","Suspect","Prejudice (legal term)"]},{"doi":"10.1016/j.jesp.2015.10.006","t":"Members of high-status groups are threatened by pro-diversity organizational messages","a":["Tessa L. Dover","Brenda Major","Cheryl R. Kaiser"],"d":"2015-10-27","abs":"","oa":"closed","url":"https://doi.org/10.1016/j.jesp.2015.10.006","pdf":"","k":["Psychology","Diversity (politics)","Social psychology","Ethnic group","White (mutation)","Social identity theory","Cultural diversity","Race (biology)"]},{"doi":"10.1016/j.jesp.2015.10.005","t":"Framing effortful strategies as easy enables depleted individuals to execute complex tasks effe