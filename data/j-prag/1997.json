[{"doi":"10.1016/s0378-2166(97)00070-2","t":"The Northridge earthquake conversations: The floor structure and the ‘loop’ sequence in Japanese conversation","a":["Shōichi Iwasaki"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)00070-2","pdf":"","k":["Conversation","Sequence (biology)","Dyad","Contextualization","Negotiation","Conversation analysis","Communication","Psychology"]},{"doi":"10.1016/s0378-2166(97)81491-9","t":"Social context, linguistic ideology, and indexical expressions in Japanese","a":["Shigeko Okamoto"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)81491-9","pdf":"","k":["Indexicality","Linguistics","Sociolinguistics","Normative","Pragmatics","Ideology","Context (archaeology)","Sociology"]},{"doi":"10.1016/s0378-2166(97)00073-8","t":"Discourse management in terms of mental spaces","a":["Yukinori Takubo","Satoshi Kinsui"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)00073-8","pdf":"","k":["Deixis","Computer science","Linguistics","Domain (mathematical analysis)","Sentence","Noun phrase","Proper noun","Dialogic"]},{"doi":"10.1016/s0378-2166(97)00071-4","t":"The role of the Japanese masu form in caregiver-child conversation","a":["Haruko Minegishi Cook"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)00071-4","pdf":"","k":["Politeness","Conversation","Socialization","Psychology","Pragmatics","Presentation (obstetrics)","Linguistics","Conversation analysis"]},{"doi":"10.1016/s0378-2166(97)00072-6","t":"The rise and fall of Japanese nonsubject honorifics: The case of ‘o-Verb-suru’","a":["Yoshiko Matsumoto"],"d":"1997-12-01","abs":"This paper seeks to describe the pragmatic content of a particular honorific form in Japanese, i.e., the productive o-Verb (stem)-suru form of nonsubject honorific. The account demonstrates the pragmatic variables that determine the acceptability of a form that is still often considered to be fully determined by ‘syntactic’ rules. In identifying what representation of the world is necessarily implied by that form, the paper claims that the determination of the target of honorification depends not only on the socially perceived relative position but also on the consonance of the action or state that is described in the sentence with a pragmatic notion of benefactivity; more specifically, with a notion of benefit transfer. At least in the conventional use of the o-V-suru form, there is an implied relationship of benefit between the two participants, in which the exalted nonsubject referent is either the beneficiary or the source of benefit, depending on the predicate and on the context. This pragmatic account also serves as a starting point for analyses of the social meaning of the use of the form in various contexts, and it is shown that certain ‘deviant’ usages suggest the outlines of the emerging pattern.","oa":"hybrid","url":"https://doi.org/10.1016/s0378-2166(97)00072-6","pdf":"","k":["Honorific","Referent","Verb","Predicate (mathematical logic)","Linguistics","Sentence","Politeness","Action (physics)"]},{"doi":"10.1016/s0378-2166(97)00079-9","t":"The influence of translation on the historical development of the Japanese passive construction","a":["Satoshi Kinsui"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)00079-9","pdf":"","k":["Transitive relation","Literal translation","Linguistics","Passive voice","Sentence","Translation (biology)","Computer science","History"]},{"doi":"10.1016/s0378-2166(97)00074-x","t":"On the co-construction of counterfactual reasoning","a":["Noriko Akatsuko"],"d":"1997-12-01","abs":"","oa":"closed","url":"https://doi.org/10.1016/s0378-2166(97)00074-x","pdf":"","k":["Counterfactual thinking","Sympathy","Counterfactual conditional","Construct (python library)","Natural (archaeology)","Similarity (geometry)","Psychology","Social psychology"]},{"doi":"10.1016/s0378-2166(